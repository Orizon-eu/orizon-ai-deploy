# The app, and everything Compose reads at parse time. Credentials in .env.secrets; model servers, connectors and nginx in .env.vllm, .env.mcp, .env.nginx. Everything else is set in the admin panel.


# ================= APPLICATION & VERSION =================
# COMPOSE_PROJECT_NAME=orizon-ai-app
ORIZON_VERSION=v1.3.0
ORIZON_IMAGE_PREFIX=scr.syneto.eu/orizon-ai/orizon-ai
COMPOSE_PROFILES=transcription
ORIZON_FEATURE_TRANSCRIPTION=true
ORIZON_FEATURE_TELEGRAM=true
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=


# ================= AUTHENTICATION =================
BETTER_AUTH_SECRET=


# ================= NGINX & TLS =================
NGINX_TEMPLATE=orizonai-http-only.conf.template
# SSL_CERT_DIR=./certs


# ================= SERVICE PORTS =================
POSTGRES_PORT=55432
FRONTEND_PORT=3000
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
SERVER_PORT=8005
SERVER_BIND_ADDRESS=127.0.0.1
TRANSCRIPTION_SERVICE_PORT=8007


# ================= DATABASE =================
DATABASE_URL=postgresql://postgres:postgres@db:5432/orizon
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=orizon


# ================= SERVICE URLS =================
FRONTEND_URLS=["https://example.com","http://localhost:${FRONTEND_PORT}","http://127.0.0.1:${FRONTEND_PORT}"]
FASTAPI_URL=http://backend:${SERVER_PORT}
TRANSCRIPTION_SERVICE_URL=http://transcription-bot:${TRANSCRIPTION_SERVICE_PORT}
BETTER_AUTH_URL=http://localhost:${FRONTEND_PORT}
SECURE_COOKIES=false
ORIZON_MCP_OAUTH_REDIRECT_URI=https://example.com/mcp/auth/callback

MCP_HUBSPOT_URL=http://mcp-hubspot:8100/mcp
MCP_FRESHDESK_URL=http://mcp-freshdesk:8101/mcp
MCP_FRESHCALLER_URL=http://mcp-freshcaller:8102/mcp
MCP_SALESFORCE_URL=http://mcp-salesforce:8103/mcp
MCP_CENTRAL_URL=http://mcp-central:8104/mcp
MCP_MICROSOFT_URL=http://mcp-microsoft:8105/mcp
MCP_GOOGLE_URL=http://mcp-google:8106/mcp
MCP_ATLASSIAN_URL=http://mcp-atlassian:8108/mcp
MCP_GITHUB_URL=http://mcp-github:8109/mcp
MCP_GITLAB_URL=http://mcp-gitlab:8110/mcp
MCP_IMAP_URL=http://mcp-imap:8111/mcp


# ================= MODEL ENDPOINTS =================
# Only for a model served outside this stack. Write the port literally, never ${...}.
# LLM_DEPLOYMENT_MODE=local
# LLM_API_URL=
# IMAGE_LLM_MODE=local
# IMAGE_LLM_API_URL=
# EMBEDDING_MODE=local
# EMBEDDING_API_URL=
# RERANK_MODE=local
# RERANK_API_URL=
# TRANSCRIPTION_BOT_VLLM_API_URL=
# DIARIZATION_API_URL=


# ================= MODELS =================
DEFAULT_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
IMAGE_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
LLM_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v2-moe
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
TRANSCRIPTION_MODEL=Qwen/Qwen3-ASR-1.7B
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1


# ================= MODEL PATHS =================
MODELS_PATH=/srv/orizon-models
MODELS_SERVE_PATH=/home/vllm/models


# ================= GPU & SYSTEM =================
CUDA_VISIBLE_DEVICES=0
BACKEND_GPU_DEVICE=0
TRANSCRIPTION_BOT_GPU_DEVICE=0
DIARIZATION_GPU_DEVICE=0
# VLLM_GPU_DEVICE=0
# EMBEDDING_VLLM_GPU_DEVICE=0
# RERANK_VLLM_GPU_DEVICE=0
OMP_NUM_THREADS=1


# ================= BACKEND RESOURCES =================
# BACKEND_CPU_LIMIT=16.0
# BACKEND_CPU_RESERVATION=8.0
# BACKEND_MEMORY_LIMIT=64G
# BACKEND_MEMORY_RESERVATION=32G


# ================= STORAGE & LOGS =================
# ORIZON_SMB_MOUNT_BASE_DIR=/mnt/orizon
ORIZON_CHAT_LOG_DIR=chat_logs

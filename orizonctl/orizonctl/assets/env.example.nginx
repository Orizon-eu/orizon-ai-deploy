# What nginx and certbot are launched with. Read by those two containers and by setup-ssl.sh.


# ================= DOMAIN =================
NGINX_DOMAIN=example.com


# ================= UPSTREAMS =================
SERVER_PORT=8005
FRONTEND_PORT=3000


# ================= CERTBOT =================
CERTBOT_EMAIL=admin@example.com
CLOUDFLARE_API_TOKEN=
CERTBOT_STAGING=true
CERTBOT_FORCE_RECREATE=false
NGINX_CONTAINER_NAME=orizon-nginx

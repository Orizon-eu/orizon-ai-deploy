# What the bundled model servers load and are launched with. Read only by the vLLM and diarization containers.


# ================= MODELS =================
DEFAULT_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
LLM_EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v2-moe
RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
TRANSCRIPTION_MODEL=Qwen/Qwen3-ASR-1.7B
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
DIARIZATION_MODEL_LOCAL_DIR=speaker-diarization-3.1


# ================= PATHS =================
MODELS_SERVE_PATH=/home/vllm/models


# ================= GPU MEMORY =================
GPU_MEMORY_UTILIZATION=0.50
EMBEDDING_GPU_MEMORY_UTILIZATION=0.10
RERANK_GPU_MEMORY_UTILIZATION=0.12
TRANSCRIPTION_BOT_GPU_MEMORY_UTILIZATION=0.40


# ================= TEXT =================
VLLM_DTYPE=bfloat16
TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=262144
VLLM_MAX_NUM_SEQS=32
VLLM_MAX_NUM_BATCHED_TOKENS=8192
BLOCK_SIZE=16
VLLM_REASONING_PARSER=qwen3
VLLM_TOOL_CALL_PARSER=qwen3_xml
VLLM_QUANTIZATION=
VLLM_ENFORCE_EAGER=


# ================= EMBEDDING =================
EMBEDDING_VLLM_DTYPE=bfloat16
EMBEDDING_MAX_MODEL_LEN=2048
EMBEDDING_MAX_NUM_SEQS=16
EMBEDDING_MAX_NUM_BATCHED_TOKENS=16384
EMBEDDING_BLOCK_SIZE=16
EMBEDDING_VLLM_QUANTIZATION=


# ================= RERANK =================
RERANK_VLLM_DTYPE=bfloat16
RERANK_MAX_MODEL_LEN=4096
RERANK_MAX_NUM_SEQS=8
RERANK_MAX_NUM_BATCHED_TOKENS=8192
RERANK_BLOCK_SIZE=16
RERANK_VLLM_QUANTIZATION=


# ================= DIARIZATION =================
DIARIZATION_PIPELINE_POOL_SIZE=2

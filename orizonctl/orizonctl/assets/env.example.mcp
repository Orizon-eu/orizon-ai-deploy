# What the MCP connector containers are launched with. Read only by them.


# ================= PORTS =================
MCP_HUBSPOT_PORT=8100
MCP_FRESHDESK_PORT=8101
MCP_FRESHCALLER_PORT=8102
MCP_SALESFORCE_PORT=8103
MCP_CENTRAL_PORT=8104
MCP_MICROSOFT_PORT=8105
MCP_GOOGLE_PORT=8106
MCP_SANDBOX_PORT=8107
MCP_ATLASSIAN_PORT=8108
MCP_GITHUB_PORT=8109
MCP_GITLAB_PORT=8110
MCP_IMAP_PORT=8111


# ================= SERVER =================
MCP_HOST=0.0.0.0
MCP_ALLOWED_HOSTS=mcp-hubspot:8100,localhost:8100,mcp-freshdesk:8101,localhost:8101,mcp-freshcaller:8102,localhost:8102,mcp-salesforce:8103,localhost:8103,mcp-central:8104,localhost:8104,mcp-microsoft:8105,localhost:8105,mcp-google:8106,localhost:8106,mcp-sandbox:8107,localhost:8107,mcp-atlassian:8108,localhost:8108,mcp-github:8109,localhost:8109,mcp-gitlab:8110,localhost:8110,mcp-imap:8111,localhost:8111


# ================= TIMEOUTS =================
UPLOAD_TIMEOUT=180


# ================= CACHES =================
TICKETS_CACHE_TTL_SECONDS=600
TICKETS_CACHE_MAX_USERS=10
CALLS_CACHE_TTL_SECONDS=600
CALLS_CACHE_MAX_USERS=10


# ================= MICROSOFT =================
TIMEZONE=Europe/Rome


# ================= CODE SANDBOX =================
SANDBOX_IMAGE=orizon-sandbox-runtime:local
SANDBOX_PACKAGES=numpy==2.4.6,pandas==3.0.5,scipy==1.17.1,matplotlib==3.11.1,seaborn==0.13.2,scikit-learn==1.9.0,statsmodels==0.15.0,sympy==1.14.0,networkx==3.6.1,pillow==12.3.0,openpyxl==3.1.5,tabulate==0.10.0,python-dateutil==2.9.0.post0,pytz==2026.3.post1,python-docx==1.2.0,python-pptx==1.0.2,reportlab==5.0.1,pymupdf==1.28.2
SANDBOX_IMAGE_REBUILD=false
